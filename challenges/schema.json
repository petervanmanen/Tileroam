{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/petervanmanen/Tileroam/main/challenges/schema.json",
  "title": "Tileroam challenge (format 1)",
  "description": "A GeoJSON FeatureCollection with a tileroam block. See challenges/README.md.",
  "type": "object",
  "required": [
    "type",
    "tileroam",
    "features"
  ],
  "properties": {
    "type": {
      "const": "FeatureCollection"
    },
    "tileroam": {
      "type": "object",
      "required": [
        "format",
        "name",
        "kind"
      ],
      "properties": {
        "format": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1
        },
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "tab": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "locations",
            "routes"
          ]
        },
        "icon": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8,
          "description": "One emoji."
        },
        "description": {
          "type": "string"
        },
        "attribution": {
          "type": "string"
        },
        "url": {
          "type": "string",
          "pattern": "^https?://"
        },
        "sports": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "Cycling",
              "E-biking",
              "Running",
              "Walking",
              "Hiking",
              "Swimming",
              "Skiing",
              "Snowboarding",
              "Cross-country skiing",
              "Rowing",
              "Inline skating",
              "Fitness"
            ]
          }
        },
        "radius": {
          "type": "number",
          "minimum": 10,
          "maximum": 5000,
          "default": 200
        },
        "complete": {
          "enum": [
            "cover",
            "cross"
          ],
          "default": "cover"
        },
        "coverage": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 1,
          "default": 0.9
        },
        "spacing": {
          "type": "number",
          "minimum": 10,
          "maximum": 1000,
          "default": 50
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "locations"
              }
            }
          },
          "then": {
            "not": {
              "required": [
                "complete"
              ]
            }
          }
        }
      ]
    },
    "features": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/feature"
      }
    }
  },
  "$defs": {
    "position": {
      "type": "array",
      "minItems": 2,
      "prefixItems": [
        {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        }
      ]
    },
    "line": {
      "type": "array",
      "minItems": 2,
      "items": {
        "$ref": "#/$defs/position"
      }
    },
    "feature": {
      "type": "object",
      "required": [
        "type",
        "geometry",
        "properties"
      ],
      "properties": {
        "type": {
          "const": "Feature"
        },
        "id": {
          "type": [
            "string",
            "number"
          ]
        },
        "geometry": {
          "oneOf": [
            {
              "type": "object",
              "required": [
                "type",
                "coordinates"
              ],
              "properties": {
                "type": {
                  "const": "Point"
                },
                "coordinates": {
                  "$ref": "#/$defs/position"
                }
              }
            },
            {
              "type": "object",
              "required": [
                "type",
                "coordinates"
              ],
              "properties": {
                "type": {
                  "const": "LineString"
                },
                "coordinates": {
                  "$ref": "#/$defs/line"
                }
              }
            },
            {
              "type": "object",
              "required": [
                "type",
                "coordinates"
              ],
              "properties": {
                "type": {
                  "const": "MultiLineString"
                },
                "coordinates": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "$ref": "#/$defs/line"
                  }
                }
              }
            }
          ]
        },
        "properties": {
          "type": "object",
          "required": [
            "name"
          ],
          "properties": {
            "id": {
              "type": [
                "string",
                "number"
              ]
            },
            "name": {
              "type": "string",
              "minLength": 1
            },
            "subtitle": {
              "type": "string"
            },
            "icon": {
              "type": "string",
              "minLength": 1,
              "maxLength": 8
            },
            "url": {
              "type": "string",
              "pattern": "^https?://"
            },
            "difficulty": {
              "enum": [
                "easy",
                "moderate",
                "hard",
                "very-hard"
              ]
            }
          }
        }
      },
      "anyOf": [
        {
          "required": [
            "id"
          ]
        },
        {
          "properties": {
            "properties": {
              "required": [
                "id"
              ]
            }
          }
        }
      ]
    }
  }
}
