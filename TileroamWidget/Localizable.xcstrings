    "Garmin Connect can't be reached right now.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Garmin Connect is nu niet bereikbaar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Garmin Connect est injoignable pour le moment."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se puede acceder a Garmin Connect ahora."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Garmin Connect ist gerade nicht erreichbar."
          }
        }
      }
    },
    "Garmin asks to slow down. Tileroam continues later.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Garmin vraagt om het rustiger aan te doen. Tileroam gaat later verder."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Garmin demande de ralentir. Tileroam continuera plus tard."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Garmin pide ir más despacio. Tileroam continuará más tarde."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Garmin bittet um eine Pause. Tileroam macht später weiter."
          }
        }
      }
    },
    "Garmin didn't accept the key. It may have expired: create a new one on Garmin Connect and connect again.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Garmin heeft de sleutel niet geaccepteerd. Misschien is hij verlopen: maak een nieuwe op Garmin Connect en koppel opnieuw."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Garmin n’a pas accepté la clé. Elle a peut-être expiré : créez-en une nouvelle sur Garmin Connect et reconnectez-vous."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Garmin no ha aceptado la clave. Puede que haya caducado: crea una nueva en Garmin Connect y vuelve a conectar."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Garmin hat den Schlüssel nicht akzeptiert. Vielleicht ist er abgelaufen: Erstelle auf Garmin Connect einen neuen und verbinde dich erneut."
          }
        }
      }
    },
    "Garmin didn't accept the key: connect again in Tileroam.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Garmin heeft de sleutel niet geaccepteerd: koppel opnieuw in Tileroam."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
