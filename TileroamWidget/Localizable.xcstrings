          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Garmin no ha aceptado la clave: vuelve a conectar en Tileroam."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Garmin hat den Schlüssel nicht akzeptiert: Verbinde dich erneut in Tileroam."
          }
        }
      }
