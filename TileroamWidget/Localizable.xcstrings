    "A map of the tiles around your current location: visited tiles in green.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een kaart van de tegels rond je huidige locatie: bezochte tegels in groen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une carte des tuiles autour de votre position : les tuiles visitées en vert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un mapa de las teselas alrededor de tu ubicación: las visitadas en verde."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Karte der Kacheln rund um deinen Standort: besuchte Kacheln in Grün."
          }
        }
      }
    },
