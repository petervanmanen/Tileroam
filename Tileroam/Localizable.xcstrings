    "Badges in colour are yours; tap one to see what it takes. Indoor and virtual activities count too.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Badges in kleur heb je verdiend; tik erop om te zien wat ervoor nodig is. Indoor- en virtuele activiteiten tellen ook mee."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les badges en couleur sont à vous ; touchez-en un pour voir ce qu’il faut. Les activités en salle et virtuelles comptent aussi."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las insignias en color son tuyas; toca una para ver qué hace falta. Las actividades en interior y virtuales también cuentan."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Farbige Abzeichen hast du verdient; tippe auf eines, um zu sehen, was es braucht. Indoor- und virtuelle Aktivitäten zählen auch."
          }
        }
      }
    },
