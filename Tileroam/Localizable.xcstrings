    "Location access is off. Allow Tileroam to use your location in Settings to plan a route from where you are.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Locatietoegang staat uit. Sta Tileroam in Instellingen toe je locatie te gebruiken om een route vanaf je positie te plannen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’accès à la position est désactivé. Autorisez Tileroam dans Réglages à utiliser votre position pour planifier un parcours depuis l’endroit où vous êtes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El acceso a la ubicación está desactivado. Permite a Tileroam usar tu ubicación en Ajustes para planificar una ruta desde donde estás."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Standortzugriff ist aus. Erlaube Tileroam in den Einstellungen, deinen Standort zu verwenden, um eine Route ab deinem Standort zu planen."
          }
        }
      }
    },
