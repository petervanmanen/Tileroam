    "It downloads again the next time you plan a route.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het wordt opnieuw gedownload als je weer een route plant."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Elles seront retéléchargées la prochaine fois que vous planifierez un parcours."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se vuelve a descargar la próxima vez que planifiques una ruta."
          }
