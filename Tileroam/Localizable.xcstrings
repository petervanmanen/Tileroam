    "Tracks, tiles and areas read from your .fit files, so they don't have to be read again at every start. Clearing it reads all files again.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sporen, tegels en gebieden uit je .fit-bestanden, zodat ze niet bij elke start opnieuw gelezen hoeven te worden. Wissen leest alle bestanden opnieuw."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Traces, tuiles et zones lues dans vos fichiers .fit, pour ne pas les relire à chaque démarrage. Le vider relit tous les fichiers."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Recorridos, teselas y zonas leídos de tus archivos .fit, para no tener que leerlos en cada inicio. Al vaciarla se leen todos los archivos de nuevo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tracks, Kacheln und Gebiete aus deinen .fit-Dateien, damit sie nicht bei jedem Start neu gelesen werden. Leeren liest alle Dateien neu ein."
          }
        }
      }
    },
