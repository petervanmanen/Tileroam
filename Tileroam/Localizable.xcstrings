    "Strava access was revoked. Please connect again.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Toegang tot Strava is ingetrokken. Koppel opnieuw."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’accès à Strava a été révoqué. Reconnectez-vous."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se revocó el acceso a Strava. Vuelve a conectarte."
          }
