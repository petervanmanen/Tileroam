    "%lld activity files on this device, and with iCloud sync also in iCloud Drive › Tileroam. Imported files are copied once.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld activiteitbestanden op dit apparaat, en met iCloud-synchronisatie ook in iCloud Drive › Tileroam. Geïmporteerde bestanden worden één keer gekopieerd."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld fichiers d’activité sur cet appareil, et avec la synchronisation iCloud aussi dans iCloud Drive › Tileroam. Les fichiers importés sont copiés une fois."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld archivos de actividad en este dispositivo y, con la sincronización de iCloud, también en iCloud Drive › Tileroam. Los archivos importados se copian una vez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld Aktivitätsdateien auf diesem Gerät, mit iCloud-Sync auch in iCloud Drive › Tileroam. Importierte Dateien werden einmal kopiert."
          }
        }
      }
    },
    "%lld activity files on this device. Sign in to iCloud with iCloud Drive on to share them with your other devices.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld activiteitbestanden op dit apparaat. Log in bij iCloud met iCloud Drive aan om ze met je andere apparaten te delen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld fichiers d’activité sur cet appareil. Connectez-vous à iCloud avec iCloud Drive activé pour les partager avec vos autres appareils."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld archivos de actividad en este dispositivo. Inicia sesión en iCloud con iCloud Drive activado para compartirlos con tus otros dispositivos."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld Aktivitätsdateien auf diesem Gerät. Melde dich bei iCloud mit aktiviertem iCloud Drive an, um sie mit deinen anderen Geräten zu teilen."
          }
        }
      }
    },
