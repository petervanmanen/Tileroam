          }
        }
      }
    },
    "Import .fit files, or connect Strava, to see where you have been.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Importeer .fit-bestanden of koppel Strava om te zien waar je bent geweest."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Importez des fichiers .fit ou connectez Strava pour voir où vous êtes allé."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Importa archivos .fit o conecta Strava para ver dónde has estado."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Importiere .fit-Dateien oder verbinde Strava, um zu sehen, wo du warst."
          }
        }
      }
    },
    "Import your .fit files, for example exports from HealthFit, Garmin or Wahoo: separate files or a whole folder. Tileroam keeps its own copy, and with iCloud your other devices have them too.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Importeer je .fit-bestanden, bijvoorbeeld exports van HealthFit, Garmin of Wahoo: losse bestanden of een hele map. Tileroam bewaart een eigen kopie, en met iCloud hebben je andere apparaten ze ook."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Importez vos fichiers .fit, par exemple des exports de HealthFit, Garmin ou Wahoo : des fichiers séparés ou un dossier entier. Tileroam garde sa propre copie, et avec iCloud vos autres appareils les ont aussi."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Importa tus archivos .fit, por ejemplo exportaciones de HealthFit, Garmin o Wahoo: archivos sueltos o una carpeta entera. Tileroam guarda su propia copia y, con iCloud, tus otros dispositivos también los tienen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Importiere deine .fit-Dateien, zum Beispiel Exporte aus HealthFit, Garmin oder Wahoo: einzelne Dateien oder einen ganzen Ordner. Tileroam behält eine eigene Kopie, und mit iCloud haben deine anderen Geräte sie auch."
          }
        }
      }
    },
