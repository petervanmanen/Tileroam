          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktivitäten ohne GPS (Indoor-Training oder ohne Route in Apple Health synchronisiert) werden gezählt, können aber nicht gezeichnet werden."
          }
        }
      }
    },
