    "Tile %lld/%lld": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tegel %1$lld/%2$lld"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tuile %1$lld/%2$lld"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tesela %1$lld/%2$lld"
          }
        },
        "de": {
