    "Only the .fit files Tileroam saved from Strava are deleted; files from other apps are kept.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alleen de .fit-bestanden die Tileroam van Strava heeft bewaard worden verwijderd; bestanden van andere apps blijven staan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seuls les fichiers .fit que Tileroam a enregistrés depuis Strava sont supprimés ; les fichiers des autres apps sont conservés."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo se eliminan los archivos .fit que Tileroam guardó de Strava; los de otras apps se conservan."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur die .fit-Dateien, die Tileroam von Strava gespeichert hat, werden gelöscht; Dateien anderer Apps bleiben erhalten."
          }
        }
      }
    },
