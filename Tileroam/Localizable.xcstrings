    "Downloaded for the countries you have activities in. They're small and load again automatically, so they can't be removed here.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gedownload voor de landen waarin je activiteiten hebt. Ze zijn klein en worden automatisch opnieuw geladen, dus je kunt ze hier niet verwijderen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Téléchargés pour les pays où vous avez des activités. Ils sont petits et se rechargent automatiquement, ils ne peuvent donc pas être supprimés ici."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Descargados para los países donde tienes actividades. Son pequeños y se cargan de nuevo automáticamente, así que no se pueden eliminar aquí."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für die Länder geladen, in denen du Aktivitäten hast. Sie sind klein und werden automatisch neu geladen, daher kann man sie hier nicht entfernen."
          }
        }
      }
    },
