    },
    "Allow Tileroam to use your location in Settings to center the map on where you are.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sta Tileroam in Instellingen toe je locatie te gebruiken om de kaart op je positie te centreren."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisez Tileroam à utiliser votre position dans Réglages pour centrer la carte sur l’endroit où vous êtes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite que Tileroam use tu ubicación en Ajustes para centrar el mapa donde estás."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlaube Tileroam in den Einstellungen, deinen Standort zu verwenden, um die Karte auf dich zu zentrieren."
          }
        }
      }
    },
    "An activity every working day, none in the weekend before or after": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Elke werkdag een activiteit, geen in het weekend ervoor of erna"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une activité chaque jour ouvré, aucune le week-end avant ou après"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una actividad cada día laborable, ninguna el fin de semana anterior ni posterior"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeden Werktag eine Aktivität, keine am Wochenende davor oder danach"
          }
        }
      }
    },
