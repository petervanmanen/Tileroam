    "See everywhere you have been: every map tile, municipality and postcode area you have visited on your rides, runs and walks.": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zie overal waar je bent geweest: elke kaarttegel, gemeente en elk postcodegebied dat je hebt bezocht tijdens je ritten, hardlooprondes en wandelingen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Voyez partout où vous êtes allé : chaque tuile, commune et zone de code postal visitée lors de vos sorties à vélo, courses et marches."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mira todo lo que has recorrido: cada tesela del mapa, municipio y código postal que has visitado en tus salidas en bici, carreras y paseos."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sieh, wo du überall warst: jede Kartenkachel, Gemeinde und jedes Postleitzahlgebiet, das du auf Radtouren, Läufen und Wanderungen besucht hast."
          }
        }
      }
    },
