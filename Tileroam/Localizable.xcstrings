    "The Boscafé Challenge: visit 53 cafés in the woods": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De Boscafé-uitdaging: bezoek 53 cafés in het bos"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le défi des cafés en forêt : visitez 53 cafés dans les bois"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El desafío de cafés del bosque: visita 53 cafés en el bosque"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Waldcafé-Challenge: besuche 53 Cafés im Wald"
          }
        }
      }
    },
    "The Trappist Challenge: ride past the Trappist breweries": {
      "localizations": {
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De Trappistenuitdaging: fiets langs de trappistenbrouwerijen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le défi trappiste : passez devant les brasseries trappistes"
          }
        },
