{
  "sourceLanguage": "en",
  "strings": {
    "NSLocationWhenInUseUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tileroam uses your location to show where you are on the map and to plan cycling routes from there. To plan a route, your start point and stops are sent to the OpenStreetMap routing service."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tileroam gebruikt je locatie om te tonen waar je bent en om fietsroutes vanaf daar te plannen. Voor een route worden je startpunt en stops naar de routeplanner van OpenStreetMap gestuurd."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tileroam utilise votre position pour l’afficher sur la carte et planifier des parcours à vélo depuis celle-ci. Pour planifier, votre point de départ et vos étapes sont envoyés au service d’itinéraires OpenStreetMap."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tileroam usa tu ubicación para mostrar dónde estás y planificar rutas en bici desde allí. Para planificar, tu punto de partida y paradas se envían al servicio de rutas de OpenStreetMap."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tileroam nutzt deinen Standort, um ihn auf der Karte zu zeigen und Radrouten ab dort zu planen. Zum Planen werden Start und Stopps an den Routingdienst von OpenStreetMap gesendet."
          }
        }
      },
      "shouldTranslate": true
    },
    "CFBundleDisplayName": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tileroam"
          }
        },
        "nl": {
